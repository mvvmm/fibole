{
  "name": "fibole",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "preview": "vite preview",
    "deploy": "cf deploy",
    "cf-typegen": "cf workers types",
    "db:migrate:local": "cf d1 migrations apply 5fc36128-3e05-4fec-aded-4d0217231297 --local --persist-to .cloudflare/state",
    "db:migrate:prod": "cf d1 migrations apply 5fc36128-3e05-4fec-aded-4d0217231297",
    "generate": "tsx scripts/generate-questions.ts",
    "generate:assets": "tsx scripts/generate-og-assets.ts",
    "metrics": "tsx scripts/metrics.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "cf workers types && tsc --build",
    "lint": "oxlint src worker",
    "format:check": "oxfmt --check src worker vite.config.ts vitest.config.ts cloudflare.config.ts scripts/check-app.mjs",
    "format:write": "oxfmt src worker vite.config.ts vitest.config.ts cloudflare.config.ts scripts/check-app.mjs",
    "deploy:preview": "cf previews deploy",
    "check:app": "node scripts/check-app.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.36.3",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^22.19.21",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "cf": "1.0.0-beta.18",
    "dotenv": "^16.6.1",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "puppeteer-core": "^25.1.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
